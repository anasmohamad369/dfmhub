generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ProjectRegistration {
  id          String   @id @default(cuid())
  fullName    String
  phoneNumber String
  email       String
  companyName String
  location    String?
  requirement String?
  source      String   @default("WEBSITE_CONTACT")
  status      String   @default("NEW")
  assignedTo  String?
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_registrations")
}

model ProjectDetail {
  id               String   @id @default(cuid())
  registrationId   String?  // Foreign link ID to ProjectRegistration
  userFullName     String?  // Linked customer full name
  userPhone        String?  // Linked customer phone
  userEmail        String?  // Linked customer email
  siteName         String
  location         String
  occupancy        String
  dimensions       String
  soilType         String
  climateZone      String
  avgResistance    String
  targetResistance String
  checklistScore   String
  lplClass         String
  riskR1           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("project_details")
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String   // "LIGHTNING_PROTECTION", "STRUCTURAL_EARTHING", "STANDARDS", "TESTING", "SURGE_PROTECTION", "MAINTENANCE"
  readTime  String   @default("5 min read")
  summary   String
  content   String
  author    String   @default("DFMHUB Engineering Team")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_posts")
}

model Product {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  description        String
  price              Float?
  category           String   // e.g., "LIGHTNING_PROTECTION", "STRUCTURAL_EARTHING"
  imageUrl           String?
  inStock            Boolean  @default(true)
  brand              String?
  primaryApplication String?
  specifications     Json?
  features           Json?
  useCases           Json?
  faqs               Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("products")
}
